<Project>

  <!--
    Issue #678 — imported by ../Directory.Build.targets ONLY for the perf-bench
    WinUI app executables when the build host is ARM64.

    Replace the SDK's Build target with a no-op so the WinUI app build chain is
    never invoked on an ARM64 dev box, where its native tooling fails under x86
    emulation against a OneDrive-backed working tree:
      * XamlCompiler.exe (x86 / .NET Framework 4.7.2) — the XAML markup compiler
        used by the *.Bound / *.Direct apps (App.xaml). Reports
        `Input JSON file ... doesn't exist!` -> MSB3073.
      * the PRI / MakePri resource indexer — used by every WinUI app; the
        *.Reactor / ControlModel apps fail in WinAppSdkExpandPriContent with
        `... .pri.xml does not exist` (APPX0002 / PRI180).

    This file is imported after Microsoft.Common.CurrentVersion.targets (via
    Directory.Build.targets), so this Build definition overrides the SDK's.
    Nothing references these leaf benchmark executables, so skipping their build
    does not affect any other project. They build normally on x64 (CI / the
    /perf gate), where this native tooling runs without emulation.
  -->
  <Target Name="Build">
    <Message Importance="high"
             Text="$(MSBuildProjectName): skipped on ARM64 host. The WinUI app build tools (XAML markup compiler XamlCompiler.exe, x86/.NET Framework 4.7.2; and the PRI/MakePri resource indexer) fail under ARM64 x86-emulation on this OneDrive-backed working tree (issue #678). This benchmark harness builds normally on x64 (CI and the /perf gate). Force a build with -p:PerfBenchHostArchitecture=X64." />
  </Target>

</Project>
